--// NoClip Blindado e Persistente
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Limpa conexões antigas para evitar acumulo
if _G.NoClipConnection then
    _G.NoClipConnection:Disconnect()
    _G.NoClipConnection = nil
end

_G.NoClipActive = true

-- Função principal de NoClip por frame
_G.NoClipConnection = RunService.Stepped:Connect(function()
    if not _G.NoClipActive then return end
    
    local character = LocalPlayer.Character
    if character then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

-- Reaplicar caso o player morra e renasça
LocalPlayer.CharacterAdded:Connect(function(newChar)
    task.wait(0.5)
    local character = newChar
    if _G.NoClipActive then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end
    end
end)

print("[Number One] NoClip Blindado Ativado!")
