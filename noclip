local OwnerName = "SEU_NICK_PRINCIPAL_AQUI"

-- 1. Limpeza gráfica e remoção de texturas do mapa
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.Technology = Enum.Technology.Compatibility

	-- Remove texturas, decalques e materiais pesados do workspace para deixar tudo liso
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Texture") or obj:IsA("Decal") then
			obj:Destroy()
		elseif obj:IsA("BasePart") then
			obj.Material = Enum.Material.SmoothPlastic
		end
	end

	-- Ouve caso novas partes sejam carregadas no mapa
	workspace.DescendantAdded:Connect(function(obj)
		if obj:IsA("Texture") or obj:IsA("Decal") then
			obj:Destroy()
		elseif obj:IsA("BasePart") then
			obj.Material = Enum.Material.SmoothPlastic
		end
	end)
end)

-- 2. Anti-Lag Ajustado (Raio de visão em 80 studs)
pcall(function()
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local RunService = game:GetService("RunService")

	local counter = 0
	RunService.Heartbeat:Connect(function()
		counter = counter + 1
		if counter % 30 ~= 0 then return end

		pcall(function()
			local localChar = LocalPlayer.Character
			local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
			if not localRoot then return end

			local ownerPlayer = Players:FindFirstChild(OwnerName)
			if ownerPlayer and ownerPlayer.Character then
				for _, part in ipairs(localChar:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end

			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local char = player.Character
					local root = char:FindFirstChild("HumanoidRootPart")
					
					if root then
						local distance = (root.Position - localRoot.Position).Magnitude
						if distance > 80 then
							for _, part in ipairs(char:GetDescendants()) do
								if part:IsA("BasePart") then
									part.Transparency = 1
									part.CanCollide = false
								end
							end
						else
							for _, part in ipairs(char:GetDescendants()) do
								if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency == 1 then
									part.Transparency = 0
									part.CanCollide = true
								end
							end
						end
					end
				end
			end
		end)
	end)
end)

-- 3. Painel Flutuante Minimalista (Branco Liso) com Voo e Inclinação Fluida
pcall(function()
	local CoreGui = game:GetService("CoreGui")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local LocalPlayer = game:GetService("Players").LocalPlayer
	local Camera = workspace.CurrentCamera

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "YHub_MinimalistFlight"
	screenGui.Parent = CoreGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 210, 0, 115)
	frame.Position = UDim2.new(0, 30, 0, 150)
	frame.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
	frame.BorderSizePixel = 0
	frame.Active = true
	frame.Draggable = true
	frame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -40, 0, 30)
	title.Position = UDim2.new(0, 10, 0, 0)
	title.BackgroundTransparency = 1
	title.Text = "Y Hub - Minimalista"
	title.TextColor3 = Color3.fromRGB(30, 30, 30)
	title.TextSize = 11
	title.Font = Enum.Font.SourceSansBold
	title.TextXAlignment = Enum.TextXAlignment.Left
	title.Parent = frame

	local minimizeBtn = Instance.new("TextButton")
	minimizeBtn.Size = UDim2.new(0, 24, 0, 20)
	minimizeBtn.Position = UDim2.new(1, -28, 0, 5)
	minimizeBtn.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
	minimizeBtn.Text = "-"
	minimizeBtn.TextColor3 = Color3.fromRGB(40, 40, 40)
	minimizeBtn.TextSize = 12
	minimizeBtn.Font = Enum.Font.SourceSansBold
	minimizeBtn.Parent = frame
	Instance.new("UICorner", minimizeBtn).CornerRadius = UDim.new(0, 4)

	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(0, 190, 0, 26)
	toggleBtn.Position = UDim2.new(0, 10, 0, 34)
	toggleBtn.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
	toggleBtn.Text = "Voo Inclinado: OFF"
	toggleBtn.TextColor3 = Color3.fromRGB(180, 40, 40)
	toggleBtn.TextSize = 11
	toggleBtn.Font = Enum.Font.SourceSansBold
	toggleBtn.Parent = frame
	Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 5)

	local speedVal = 60

	local speedLabel = Instance.new("TextLabel")
	speedLabel.Size = UDim2.new(0, 190, 0, 20)
	speedLabel.Position = UDim2.new(0, 10, 0, 64)
	speedLabel.BackgroundTransparency = 1
	speedLabel.Text = "Velocidade: 60"
	speedLabel.TextColor3 = Color3.fromRGB(80, 80, 80)
	speedLabel.TextSize = 11
	speedLabel.Font = Enum.Font.SourceSansBold
	speedLabel.TextXAlignment = Enum.TextXAlignment.Left
	speedLabel.Parent = frame

	local menosBtn = Instance.new("TextButton")
	menosBtn.Size = UDim2.new(0, 90, 0, 22)
	menosBtn.Position = UDim2.new(0, 10, 0, 87)
	menosBtn.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
	menosBtn.Text = "- Velocidade"
	menosBtn.TextColor3 = Color3.fromRGB(50, 50, 50)
	menosBtn.TextSize = 10
	menosBtn.Font = Enum.Font.SourceSansBold
	menosBtn.Parent = frame
	Instance.new("UICorner", menosBtn).CornerRadius = UDim.new(0, 4)

	local maisBtn = Instance.new("TextButton")
	maisBtn.Size = UDim2.new(0, 90, 0, 22)
	maisBtn.Position = UDim2.new(0, 110, 0, 87)
	maisBtn.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
	maisBtn.Text = "+ Velocidade"
	maisBtn.TextColor3 = Color3.fromRGB(50, 50, 50)
	maisBtn.TextSize = 10
	maisBtn.Font = Enum.Font.SourceSansBold
	maisBtn.Parent = frame
	Instance.new("UICorner", maisBtn).CornerRadius = UDim.new(0, 4)

	local active = false
	local isMinimized = false
	local flightTrack = nil
	local bodyVelocity = nil
	local currentTilt = 0

	minimizeBtn.MouseButton1Click:Connect(function()
		isMinimized = not isMinimized
		if isMinimized then
			toggleBtn.Visible = false
			speedLabel.Visible = false
			menosBtn.Visible = false
			maisBtn.Visible = false
			frame.Size = UDim2.new(0, 210, 0, 30)
			minimizeBtn.Text = "+"
		else
			toggleBtn.Visible = true
			speedLabel.Visible = true
			menosBtn.Visible = true
			maisBtn.Visible = true
			frame.Size = UDim2.new(0, 210, 0, 115)
			minimizeBtn.Text = "-"
		end
	end)

	menosBtn.MouseButton1Click:Connect(function()
		speedVal = math.clamp(speedVal - 10, 20, 150)
		speedLabel.Text = "Velocidade: " .. speedVal
	end)

	maisBtn.MouseButton1Click:Connect(function()
		speedVal = math.clamp(speedVal + 10, 20, 150)
		speedLabel.Text = "Velocidade: " .. speedVal
	end)

	toggleBtn.MouseButton1Click:Connect(function()
		active = not active
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")

		if active then
			toggleBtn.Text = "Voo Inclinado: ON"
			toggleBtn.TextColor3 = Color3.fromRGB(40, 140, 40)

			if root and not bodyVelocity then
				bodyVelocity = Instance.new("BodyVelocity")
				bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				bodyVelocity.Velocity = Vector3.new(0, 0, 0)
				bodyVelocity.Parent = root
			end

			if animator then
				pcall(function()
					local anim = Instance.new("Animation")
					anim.AnimationId = "rbxassetid://616006778"
					flightTrack = animator:LoadAnimation(anim)
					flightTrack.Priority = Enum.AnimationPriority.Action4
					flightTrack:Play()
					flightTrack:AdjustSpeed(0)
				end)
			end
		else
			toggleBtn.Text = "Voo Inclinado: OFF"
			toggleBtn.TextColor3 = Color3.fromRGB(180, 40, 40)
			currentTilt = 0

			if bodyVelocity then
				bodyVelocity:Destroy()
				bodyVelocity = nil
			end

			if flightTrack then
				pcall(function()
					flightTrack:Stop()
					flightTrack:Destroy()
				end)
				flightTrack = nil
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		local char = LocalPlayer.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart")

		if active and root and bodyVelocity then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end

			local camCFrame = Camera.CFrame
			local moveDirection = Vector3.new(0, 0, 0)

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				moveDirection = moveDirection + camCFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				moveDirection = moveDirection - camCFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				moveDirection = moveDirection - camCFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				moveDirection = moveDirection + camCFrame.RightVector
			end

			local targetTilt = 0

			if moveDirection.Magnitude > 0 then
				bodyVelocity.Velocity = moveDirection * speedVal
				targetTilt = 55
				
				if flightTrack then
					flightTrack:AdjustSpeed(1)
				end
			else
				bodyVelocity.Velocity = Vector3.new(0, 0, 0)
				targetTilt = 0
				
				if flightTrack then
					flightTrack:AdjustSpeed(0)
				end
			end

			currentTilt = currentTilt + (targetTilt - currentTilt) * 0.15

			local baseCFrame = CFrame.new(root.Position, root.Position + Vector3.new(camCFrame.LookVector.X, 0, camCFrame.LookVector.Z))
			root.CFrame = baseCFrame * CFrame.Angles(math.rad(currentTilt), 0, 0)
		end
	end)
end)

