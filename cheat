--// Y Hub Alt - Código Completo Ultra-Agressivo (Anti-Lag Máximo + Loader)
pcall(function()
	if setfpscap then
		setfpscap(30) -- Trava o FPS para aliviar o processador
	end
end)

-- 1. Limpeza gráfica extrema (Remove luzes, sombras, texturas, partículas e sons)
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Technology = Enum.Technology.Compatibility
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") then
			v.Enabled = false
		end
	end

	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Material = Enum.Material.SmoothPlastic
			v.CastShadow = false
			v.Reflectance = 0
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Explosion") then
			v:Destroy()
		elseif v:IsA("Sound") then
			v:Destroy() -- Remove poluição sonora que consome memória
		end
	end
end)

-- 2. Anti-Lag Agressivo: Congela e invisibiliza jogadores distantes e corta colisões
pcall(function()
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local RunService = game:GetService("RunService")

	local counter = 0
	RunService.Heartbeat:Connect(function()
		counter = counter + 1
		-- Roda a cada 20 frames para poupar ciclos da CPU
		if counter % 20 ~= 0 then return end

		pcall(function()
			local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not localRoot then return end

			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local char = player.Character
					local root = char:FindFirstChild("HumanoidRootPart")
					
					if root then
						local distance = (root.Position - localRoot.Position).Magnitude
						-- Se o player estiver a mais de 25 studs, desliga totalmente a renderização e colisão dele
						if distance > 25 then
							for _, part in ipairs(char:GetDescendants()) do
								if part:IsA("BasePart") then
									part.Transparency = 1
									part.CanCollide = false
									part.LocalTransparencyModifier = 1
								elseif part:IsA("Accessory") or part:IsA("Clothing") or part:IsA("BillboardGui") then
									part:Destroy()
								end
							end
						else
							-- Restaura quando se aproxima
							for _, part in ipairs(char:GetDescendants()) do
								if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency == 1 then
									part.Transparency = 0
									part.CanCollide = true
									part.LocalTransparencyModifier = 0
								end
							end
						end
					end
				end
			end
		end)
	end)
end)

-- 3. Coletor de lixo hiper-agressivo (Limpa a memória RAM a cada 2 segundos)
pcall(function()
	collectgarbage("setpause", 100)
	collectgarbage("setstepmul", 300)
	
	task.spawn(function()
		while task.wait(2) do
			collectgarbage("step", 300)
		end
	end)
end)

