--// Y Hub - Loader com Comando de Chat (!attack) e Imortalidade no Stand
pcall(function()
	if setfpscap then
		setfpscap(60)
	end
end)

-- 1. Injeção Silenciosa com Controle por Chat (!attack)
pcall(function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local VirtualInputManager = game:GetService("VirtualInputManager")
	local LocalPlayer = Players.LocalPlayer

	local isAttacking = false
	local comboTick = 0
	local nextComboDelay = 35

	-- Escuta o chat para ativar/desativar com o comando !attack
	pcall(function()
		LocalPlayer.Chatted:Connect(function(message)
			local msg = message:lower()
			if msg == "!attack" or msg == "!atacar" then
				isAttacking = not isAttacking
				if isAttacking then
					print("[Y Hub] Modo de Ataque Automático: ATIVADO!")
				else
					print("[Y Hub] Modo de Ataque Automático: DESATIVADO!")
				end
			end
		end)
	end)

	-- Loop principal leve e seguro
	RunService.Heartbeat:Connect(function(dt)
		local char = LocalPlayer.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then return end

		-- A. Imortalidade Automática no Stand
		pcall(function()
			if humanoid.PlatformStand then
				if humanoid.Health < humanoid.MaxHealth then
					humanoid.Health = humanoid.MaxHealth
				end
			end
		end)

		-- B. Só executa o combo automático se o comando !attack estiver ATIVO
		if isAttacking then
			pcall(function()
				local target = nil
				local shortestDist = math.huge
				
				-- Procura um inimigo válido nas redondezas
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
						local targetChar = player.Character
						local targetRoot = targetChar.HumanoidRootPart
						local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
						
						-- Verifica se o inimigo está vivo e não está em stand
						if targetHumanoid and targetHumanoid.Health > 0 and not targetHumanoid.PlatformStand then
							local dist = (root.Position - targetRoot.Position).Magnitude
							if dist < shortestDist and dist < 25 then
								shortestDist = dist
								target = targetRoot
								targetHumanoidObj = targetHumanoid
							end
						end
					end
				end

				-- Se encontrou um alvo vivo, executa a sequência de combate
				if target then
					root.CFrame = CFrame.new(root.Position, Vector3.new(target.Position.X, target.Position.Y, target.Position.Z))

					comboTick = comboTick + 1
					if comboTick >= nextComboDelay then
						task.spawn(function()
							local totalHits = math.random(3, 5)
							for i = 1, totalHits do
								VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
								task.wait(0.015)
								VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
								task.wait(0.025)
							end
							
							task.wait(0.04)
							VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
							task.wait(0.03)
							VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
						end)

						comboTick = 0
						nextComboDelay = math.random(30, 60)
					end
				else
					-- Se o cara morreu ou sumiu da área, desativa sozinho o modo de ataque para não ficar preso
					isAttacking = false
					print("[Y Hub] Alvo eliminado/perdido. Ataque automático desativado!")
				end
			end)
		end
	end)
end)

