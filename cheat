--// Y Hub Alt - Código Completo Final (Otimizado + Anti-Servidor Cheio + Loader)
pcall(function()
	if setfpscap then
		setfpscap(30) -- Trava o FPS da alt para aliviar totalmente a CPU
	end
end)

-- 1. Otimização gráfica para a alt rodar sem engasgar
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Technology = Enum.Technology.Compatibility
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") then
			v.Enabled = false
		end
	end

	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Material = Enum.Material.SmoothPlastic
			v.CastShadow = false
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
			v:Destroy()
		end
	end
end)

-- 2. Otimizador de Servidor Cheio: Remove renderização de acessórios de outros players distantes
pcall(function()
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local RunService = game:GetService("RunService")

	RunService.Stepped:Connect(function()
		pcall(function()
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local char = player.Character
					local root = char:FindFirstChild("HumanoidRootPart")
					local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					
					if root and localRoot then
						local distance = (root.Position - localRoot.Position).Magnitude
						-- Se o player estiver a mais de 35 studs, esconde acessórios pesados para poupar FPS
						if distance > 35 then
							for _, part in ipairs(char:GetDescendants()) do
								if part:IsA("Accessory") or part:IsA("Clothing") then
									local handle = part:FindFirstChild("Handle")
									if handle then handle.Transparency = 1 end
								end
							end
						end
					end
				end
			end
		end)
	end)
end)

-- 3. Coletor de lixo agressivo para evitar vazamento de memória na alt
pcall(function()
	collectgarbage("setpause", 150)
	collectgarbage("setstepmul", 200)
	
	task.spawn(function()
		while task.wait(5) do
			collectgarbage("step", 150)
		end
	end)
end)

