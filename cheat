--// 1. STAND COMBAT ENGINE (Alta Performance / Heartbeat)
--// =====================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

local raycastParams = RaycastParams.new()
raycastParams.FilterType = RaycastParamsType.Exclude
raycastParams.IgnoreWater = true

local Combat = {
    Attacking = false,
    CurrentTarget = nil,
    Connection = nil,
    TargetThread = nil
}

-- Busca de alvo otimizada (Procura o mais próximo em até 80 studs)
local function FindClosestTarget()
    local char = LocalPlayer.Character
    if not char then return nil end
    local myRoot = char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    local myPos = myRoot.Position
    local closest, shortestDist = nil, 80

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")

            if root and hum and hum.Health > 0 then
                local dist = (myPos - root.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = p.Character
                end
            end
        end
    end
    return closest
end

-- Posicionamento fluido usando o frame do jogo
local function StepPosition(targetChar)
    local myChar = LocalPlayer.Character
    if not myChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")

    if not myRoot or not targetRoot then return end

    local targetPos = targetRoot.Position
    local idealPos = (targetRoot.CFrame * CFrame.new(0, 0, 2.5)).Position

    raycastParams.FilterObjects = { myChar, targetChar }
    local result = Workspace:Raycast(targetPos, idealPos - targetPos, raycastParams)

    local finalPos = result and (result.Position + result.Normal * 0.5) or idealPos
    myRoot.CFrame = CFrame.lookAt(finalPos, targetPos)
end

-- Inicia o Ataque (Sem congelar e sem lag)
function Combat.StartAttack(onHitCallback)
    if Combat.Attacking then return end
    Combat.Attacking = true

    -- Loop 1: Varredura de alvos (5x por segundo na CPU)
    Combat.TargetThread = task.spawn(function()
        while Combat.Attacking do
            Combat.CurrentTarget = FindClosestTarget()
            task.wait(0.2)
        end
    end)

    -- Loop 2: Atualização de posição fluida no Heartbeat
    Combat.Connection = RunService.Heartbeat:Connect(function()
        if not Combat.Attacking then return end

        local target = Combat.CurrentTarget
        if target and target:FindFirstChild("HumanoidRootPart") then
            StepPosition(target)

            if type(onHitCallback) == "function" then
                pcall(onHitCallback, target)
            end
        end
    end)
end

-- Desliga e limpa a memória do script
function Combat.StopAttack()
    Combat.Attacking = false

    if Combat.Connection then
        Combat.Connection:Disconnect()
        Combat.Connection = nil
    end

    if Combat.TargetThread then
        task.cancel(Combat.TargetThread)
        Combat.TargetThread = nil
    end

    Combat.CurrentTarget = nil
end

getgenv().StandCombat = Combat


