-- 1. Otimização Agressiva de Ambiente, Texturas e Personagens (Anti-Lag Máximo)
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Technology = Enum.Technology.Compatibility
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") or v:IsA("ColorCorrectionEffect") then
			v:Destroy()
		end
	end

	local function optimizeCharacter(char)
		pcall(function()
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Material = Enum.Material.SmoothPlastic
					part.Reflectance = 0
					part.Color = Color3.fromRGB(180, 180, 180)
				elseif part:IsA("Accessory") or part:IsA("Clothing") or part:IsA("Shirt") or part:IsA("Pants") or part:IsA("CharacterMesh") then
					part:Destroy()
				elseif part:IsA("ParticleEmitter") or part:IsA("Trail") then
					part.Enabled = false
				end
			end
		end)
	end

	for _, obj in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if obj:IsA("BasePart") then
				obj.Material = Enum.Material.SmoothPlastic
				obj.Reflectance = 0
				obj.Color = Color3.fromRGB(150, 150, 150)
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				obj:Destroy()
			elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
				obj.Enabled = false
			elseif obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
				optimizeCharacter(obj)
			end
		end)
	end

	workspace.DescendantAdded:Connect(function(obj)
		pcall(function()
			if obj:IsA("BasePart") then
				obj.Material = Enum.Material.SmoothPlastic
				obj.Reflectance = 0
				obj.Color = Color3.fromRGB(150, 150, 150)
			elseif obj:IsA("Decal") or obj:IsA("Texture") then
				obj:Destroy()
			elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") then
				obj.Enabled = false
			elseif obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
				optimizeCharacter(obj)
			end
		end)
	end)
end)

-- 2. Anti-Lag e Desativação de Colisão com a Main
pcall(function()
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local RunService = game:GetService("RunService")

	local counter = 0
	RunService.Heartbeat:Connect(function()
		counter = counter + 1
		if counter % 30 ~= 0 then return end

		pcall(function()
			local localChar = LocalPlayer.Character
			local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")
			if not localRoot then return end

			local ownerPlayer = Players:FindFirstChild(OwnerName)
			if ownerPlayer and ownerPlayer.Character then
				for _, part in ipairs(localChar:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end)
	end)
end)

-- 3. Painel Flutuante com Atalho de Tecla (Delete)
pcall(function()
	local CoreGui = game:GetService("CoreGui")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local LocalPlayer = game:GetService("Players").LocalPlayer
	local Camera = workspace.CurrentCamera

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "YHub_SupermanKeybind"
	screenGui.Parent = CoreGui

	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 210, 0, 165)
	frame.Position = UDim2.new(0, 30, 0, 150)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	frame.BorderSizePixel = 0
	frame.Active = true
	frame.Draggable = true
	frame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -40, 0, 30)
	title.BackgroundTransparency = 1
	title.Text = "Y Hub - [Delete] p/ Fechar"
	title.TextColor3 = Color3.fromRGB(200, 200, 200)
	title.TextSize = 10
	title.Font = Enum.Font.SourceSansBold
	title.Parent = frame

	local minimizeBtn = Instance.new("TextButton")
	minimizeBtn.Size = UDim2.new(0, 30, 0, 20)
	minimizeBtn.Position = UDim2.new(1, -35, 0, 5)
	minimizeBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	minimizeBtn.Text = "-"
	minimizeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	minimizeBtn.TextSize = 12
	minimizeBtn.Font = Enum.Font.SourceSansBold
	minimizeBtn.Parent = frame
	Instance.new("UICorner", minimizeBtn).CornerRadius = UDim.new(0, 4)

	local noclipBtn = Instance.new("TextButton")
	noclipBtn.Size = UDim2.new(0, 190, 0, 25)
	noclipBtn.Position = UDim2.new(0, 10, 0, 35)
	noclipBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	noclipBtn.Text = "NoClip (Atravessar): OFF"
	noclipBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
	noclipBtn.TextSize = 11
	noclipBtn.Font = Enum.Font.SourceSansBold
	noclipBtn.Parent = frame
	Instance.new("UICorner", noclipBtn).CornerRadius = UDim.new(0, 5)

	local flyBtn = Instance.new("TextButton")
	flyBtn.Size = UDim2.new(0, 190, 0, 25)
	flyBtn.Position = UDim2.new(0, 10, 0, 65)
	flyBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	flyBtn.Text = "Voo Superman: OFF"
	flyBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
	flyBtn.TextSize = 11
	flyBtn.Font = Enum.Font.SourceSansBold
	flyBtn.Parent = frame
	Instance.new("UICorner", flyBtn).CornerRadius = UDim.new(0, 5)

	-- Botões de Velocidade
	local speedLabel = Instance.new("TextLabel")
	speedLabel.Size = UDim2.new(0, 190, 0, 20)
	speedLabel.Position = UDim2.new(0, 10, 0, 95)
	speedLabel.BackgroundTransparency = 1
	speedLabel.Text = "Velocidade: 1.4"
	speedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	speedLabel.TextSize = 11
	speedLabel.Font = Enum.Font.SourceSansBold
	speedLabel.Parent = frame

	local minusBtn = Instance.new("TextButton")
	minusBtn.Size = UDim2.new(0, 90, 0, 25)
	minusBtn.Position = UDim2.new(0, 10, 0, 125)
	minusBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 40)
	minusBtn.Text = "(- Velocidade)"
	minusBtn.TextColor3 = Color3.fromRGB(255, 150, 150)
	minusBtn.TextSize = 10
	minusBtn.Font = Enum.Font.SourceSansBold
	minusBtn.Parent = frame
	Instance.new("UICorner", minusBtn).CornerRadius = UDim.new(0, 5)

	local plusBtn = Instance.new("TextButton")
	plusBtn.Size = UDim2.new(0, 90, 0, 25)
	plusBtn.Position = UDim2.new(0, 110, 0, 125)
	plusBtn.BackgroundColor3 = Color3.fromRGB(40, 60, 40)
	plusBtn.Text = "(+ Velocidade)"
	plusBtn.TextColor3 = Color3.fromRGB(150, 255, 150)
	plusBtn.TextSize = 10
	plusBtn.Font = Enum.Font.SourceSansBold
	plusBtn.Parent = frame
	Instance.new("UICorner", plusBtn).CornerRadius = UDim.new(0, 5)

	local noclipActive = false
	local flyActive = false
	local isMinimized = false
	local isHidden = false
	local currentPos = nil
	local flySpeed = 1.4

	-- Atalho de teclado para esconder/mostrar o painel inteiro (Tecla Delete)
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.KeyCode == Enum.KeyCode.Delete then
			isHidden = not isHidden
			frame.Visible = not isHidden
		end
	end)

	minimizeBtn.MouseButton1Click:Connect(function()
		isMinimized = not isMinimized
		if isMinimized then
			noclipBtn.Visible = false
			flyBtn.Visible = false
			speedLabel.Visible = false
			minusBtn.Visible = false
			plusBtn.Visible = false
			frame.Size = UDim2.new(0, 210, 0, 30)
			minimizeBtn.Text = "+"
		else
			noclipBtn.Visible = true
			flyBtn.Visible = true
			speedLabel.Visible = true
			minusBtn.Visible = true
			plusBtn.Visible = true
			frame.Size = UDim2.new(0, 210, 0, 165)
			minimizeBtn.Text = "-"
		end
	end)

	noclipBtn.MouseButton1Click:Connect(function()
		noclipActive = not noclipActive
		if noclipActive then
			noclipBtn.Text = "NoClip (Atravessar): ON"
			noclipBtn.TextColor3 = Color3.fromRGB(80, 255, 80)
		else
			noclipBtn.Text = "NoClip (Atravessar): OFF"
			noclipBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
		end
	end)

	minusBtn.MouseButton1Click:Connect(function()
		flySpeed = math.max(0.2, flySpeed - 0.3)
		speedLabel.Text = string.format("Velocidade: %.1f", flySpeed)
	end)

	plusBtn.MouseButton1Click:Connect(function()
		flySpeed = math.min(10.0, flySpeed + 0.3)
		speedLabel.Text = string.format("Velocidade: %.1f", flySpeed)
	end)

	flyBtn.MouseButton1Click:Connect(function()
		flyActive = not flyActive
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")

		if flyActive then
			flyBtn.Text = "Voo Superman: ON"
			flyBtn.TextColor3 = Color3.fromRGB(80, 255, 80)
			if root then
				currentPos = root.CFrame
				root.Anchored = true
			end
			if humanoid then
				humanoid.PlatformStand = true
			end
		else
			flyBtn.Text = "Voo Superman: OFF"
			flyBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
			if root then
				root.Anchored = false
			end
			if humanoid then
				humanoid.PlatformStand = false
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		local char = LocalPlayer.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart")

		if noclipActive and root then
			local localChar = LocalPlayer.Character
			if localChar then
				for _, part in ipairs(localChar:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end

		if flyActive and root then
			local camCFrame = Camera.CFrame
			local moveDirection = Vector3.new(0, 0, 0)

			if UserInputService:IsKeyDown(Enum.KeyCode.W) then
				moveDirection = moveDirection + camCFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then
				moveDirection = moveDirection - camCFrame.LookVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then
				moveDirection = moveDirection - camCFrame.RightVector
			end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then
				moveDirection = moveDirection + camCFrame.RightVector
			end

			if currentPos then
				if moveDirection.Magnitude > 0 then
					currentPos = currentPos + (moveDirection.Unit * flySpeed)
				end
				root.CFrame = CFrame.new(currentPos.Position) * camCFrame.Rotation * CFrame.Angles(math.rad(-90), 0, 0)
			end
		end
	end)
end)

