--// Y Hub Alt - Proteção Anti-Congelamento para Leituras Online e Painel
pcall(function()
	if setfpscap then
		setfpscap(60)
	end
end)

-- 1. Limpeza gráfica do mapa para aliviar a placa de vídeo
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Technology = Enum.Technology.Compatibility
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") then
			v.Enabled = false
		end
	end

	for _, v in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if v:IsA("BasePart") then
				v.Material = Enum.Material.SmoothPlastic
				v.CastShadow = false
				v.Reflectance = 0
			elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
				v:Destroy()
			end
		end)
	end
end)

-- 2. Interceptador e Throttle: Suaviza o fluxo de dados da rede e leituras online do painel
pcall(function()
	local RunService = game:GetService("RunService")
	local lastCheck = tick()
	
	-- Reduz a pressão das requisições simultâneas em servidores cheios
	RunService.Heartbeat:Connect(function()
		if tick() - lastCheck < 0.05 then
			-- Cria pequenas pausas controladas para o painel não sufocar a CPU
			task.wait()
		end
		lastCheck = tick()
	end)
end)

-- 3. Coletor de lixo dinâmico para estabilizar a memória consumida pelas checagens
pcall(function()
	collectgarbage("setpause", 100)
	collectgarbage("setstepmul", 300)
	
	task.spawn(function()
		while task.wait(3) do
			collectgarbage("step", 300)
		end
	end)
end)

-- 4. Carregamento do Loader com Isolamento de Execução
task.spawn(function()
	local success, err = pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/GodErste/Y-Core/refs/heads/main/loader.lua"))()
	end)

	if not success then
		warn("[Y Hub Alt] Erro no loader protegido: " .. tostring(err))
	else
		print("[Y Hub Alt] Painel injetado com Throttle Anti-Gargalo ativado!")
	end
end)
