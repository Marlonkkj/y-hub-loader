--// Y Hub Alt - Versão Limpa e Definitiva (Zero Travamentos, Gráfico Liso + Loader)
pcall(function()
	if setfpscap then
		setfpscap(60) -- Mantém o FPS travado a 60 para fluidez máxima
	end
end)

-- 1. Limpeza gráfica otimizada do mapa (Remove sombras e texturas pesadas, mantendo o visual bonito e leve)
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Technology = Enum.Technology.Compatibility
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") then
			v.Enabled = false
		end
	end

	for _, v in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if v:IsA("BasePart") then
				v.Material = Enum.Material.SmoothPlastic
				v.CastShadow = false
				v.Reflectance = 0
			elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
				v:Destroy()
			end
		end)
	end
end)

-- 2. Coletor de lixo inteligente (Limpa a memória RAM periodicamente para evitar quedas de desempenho)
pcall(function()
	collectgarbage("setpause", 100)
	collectgarbage("setstepmul", 300)
	
	task.spawn(function()
		while task.wait(5) do
			collectgarbage("step", 300)
		end
	end)
end)

-- 3. Carregamento seguro e assíncrono do Loader oficial (Sem puxar a CPU do jogo)
task.spawn(function()
	local success, err = pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/GodErste/Y-Core/refs/heads/main/loader.lua"))()
	end)

	if not success then
		warn("[Y Hub Alt] Falha no loader: " .. tostring(err))
	else
		print("[Y Hub Alt] Carregado com sucesso sem travamentos!")
	end
end)
