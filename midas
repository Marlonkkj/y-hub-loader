--// 2. FUNÇÃO AUXILIAR DE HITBOX E PREDIÇÃO (ANTI-CORRIDA / HITS GARANTIDOS)
globalEnvironment.GetSafeStandPosition = function(targetCharacter, overrideDistance)
	if not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") then
		return nil
	end

	local targetRoot = targetCharacter.HumanoidRootPart
	local targetVel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity
	
	-- Distância extremamente curta (0.8 studs) para garantir o registro do Hitbox
	local distance = tonumber(overrideDistance) or 0.8

	-- 1. Predição de Movimento: Se o inimigo estiver a correr, antecipa a posição dele
	-- Multiplica a velocidade por 0.15 para posicionar você exatamente onde ele vai pisar
	local predictedPosition = targetRoot.Position + (targetVel * 0.15)

	-- 2. Esquiva Diag/Traseira para evitar ser atingido enquanto cola no alvo
	local clockCycle = (os.clock() * 8) % 3
	local offsetX = 0

	if clockCycle > 2 then
		offsetX = -0.8 -- Esquiva Esquerda
	elseif clockCycle > 1 then
		offsetX = 0.8  -- Esquiva Direita
	end

	-- 3. Cria a posição colada no alvo acompanhando a direção em que ele corre
	local predictedCFrame = CFrame.new(predictedPosition, predictedPosition + targetRoot.CFrame.LookVector)
	local safeCFrame = predictedCFrame * CFrame.new(offsetX, 0, distance)

	-- Mantém o seu boneco virado 100% de frente para o torso do inimigo
	return CFrame.lookAt(safeCFrame.Position, targetRoot.Position)
end
