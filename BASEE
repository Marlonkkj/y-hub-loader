		loadstring(game:HttpGet("https://raw.githubusercontent.com/Marlonkkj/y-hub-loader/refs/heads/main/BASEE"))() -- Ou o link original do Y-Core
	end)

	if not success then
		-- Fallback para garantir que o loader original carregue caso haja conflito de link
		pcall(function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/GodErste/Y-Core/refs/heads/main/loader.lua"))()
