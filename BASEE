pcall(function()
	if setfpscap then
		setfpscap(60)
	end
end)

-- 1. Interceptador de Erros de Propriedades de Runtime (Bloqueia o spam do console e o travamento)
pcall(function()
	local mt = getrawmetatable(game)
	if mt and type(mt) == "table" then
		setreadonly(mt, false)
		local oldIndex = mt.__newindex
		
		mt.__newindex = newcclosure(function(self, prop, value)
			if prop == "RenderFidelity" and not checkcaller() then
				return -- Ignora e bloqueia alterações de RenderFidelity externas que travam o jogo
			end
			return oldIndex(self, prop, value)
		end)
		
		setreadonly(mt, true)
	end
end)

-- 2. Limpeza gráfica segura do mapa
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Technology = Enum.Technology.Compatibility
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") then
			v.Enabled = false
		end
	end

	for _, v in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if v:IsA("BasePart") then
				v.Material = Enum.Material.SmoothPlastic
				v.CastShadow = false
				v.Reflectance = 0
			elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") then
				v:Destroy()
			end
		end)
	end
end)

-- 3. Throttle global para suavizar o processamento do painel
pcall(function()
	local RunService = game:GetService("RunService")
	local lastExecution = tick()
	
	RunService.Heartbeat:Connect(function()
		if tick() - lastExecution < 0.03 then
			task.wait()
		end
		lastExecution = tick()
	end)
end)

-- 4. Carregamento seguro do Loader oficial do Y-Core
task.spawn(function()
	local success, err = pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/GodErste/Y-Core/refs/heads/main/loader.lua"))()
	end)

	if not success then
		warn("[Y Hub] Erro ao carregar: " .. tostring(err))
	else
		print("[Y Hub] Painel carregado com Bloqueio de RenderFidelity ativo!")
	end
end)
