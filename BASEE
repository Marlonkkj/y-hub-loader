-- Função para criar Blocos Estilizados (Colunas exatas iguais ao original)
local function createSection(parent, titleText, size, position)
	local sec = Instance.new("Frame")
	sec.Size = size
	sec.Position = position
	sec.BackgroundColor3 = Color3.fromRGB(24, 20, 24)
	sec.BorderColor3 = Color3.fromRGB(70, 40, 60)
	sec.Parent = parent

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 20)
	label.Position = UDim2.new(0, 6, 0, 2)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(200, 100, 150)
	label.Text = titleText
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Font = Enum.Font.SourceSansBold
	label.TextSize = 13
	label.Parent = sec

	local container = Instance.new("ScrollingFrame")
	container.Size = UDim2.new(1, -12, 1, -26)
	container.Position = UDim2.new(0, 6, 0, 24)
	container.BackgroundTransparency = 1
	container.BorderSizePixel = 0
	container.CanvasSize = UDim2.new(0, 0, 1.3, 0)
	container.ScrollBarThickness = 2
	container.Parent = sec

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 5)
	layout.Parent = container

	return container
end

local function createToggle(parent, text, initialVal, callback)
	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(1, -4, 0, 22)
	toggleBtn.BackgroundColor3 = initialVal and Color3.fromRGB(70, 30, 55) or Color3.fromRGB(30, 25, 30)
	toggleBtn.BorderColor3 = Color3.fromRGB(70, 40, 60)
	toggleBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	toggleBtn.Text = (initialVal and "  [X] " or "  [ ] ") .. text
	toggleBtn.TextXAlignment = Enum.TextXAlignment.Left
	toggleBtn.Font = Enum.Font.SourceSans
	toggleBtn.TextSize = 12
	toggleBtn.Parent = parent

	local state = initialVal
	toggleBtn.MouseButton1Click:Connect(function()
		state = not state
		toggleBtn.Text = (state and "  [X] " or "  [ ] ") .. text
		toggleBtn.BackgroundColor3 = state and Color3.fromRGB(70, 30, 55) or Color3.fromRGB(30, 25, 30)
		pcall(function() callback(state) end)
	end)
end

local function createSlider(parent, text, currentVal, maxVal)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -4, 0, 35)
	f.BackgroundTransparency = 1
	f.Parent = parent

	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 0, 16)
	l.BackgroundTransparency = 1
	l.TextColor3 = Color3.fromRGB(200, 200, 200)
	l.Text = text
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Font = Enum.Font.SourceSans
	l.TextSize = 11
	l.Parent = f

	local bar = Instance.new("Frame")
	bar.Size = UDim2.new(1, 0, 0, 14)
	bar.Position = UDim2.new(0, 0, 0, 18)
	bar.BackgroundColor3 = Color3.fromRGB(30, 25, 30)
	bar.BorderColor3 = Color3.fromRGB(70, 40, 60)
	bar.Parent = f

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(currentVal/maxVal, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(100, 35, 75)
	fill.BorderSizePixel = 0
	fill.Parent = bar

	local valTxt = Instance.new("TextLabel")
	valTxt.Size = UDim2.new(1, 0, 1, 0)
	valTxt.BackgroundTransparency = 1
	valTxt.TextColor3 = Color3.fromRGB(255, 255, 255)
	valTxt.Text = currentVal .. "/" .. maxVal
	valTxt.Font = Enum.Font.SourceSans
	valTxt.TextSize = 11
	valTxt.Parent = bar
end

