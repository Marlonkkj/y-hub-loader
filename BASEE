--// Y Hub Alt - Bloqueador Definitivo de Texturas 8K e RenderFidelity
pcall(function()
	if setfpscap then
		setfpscap(60)
	end
end)

-- 1. Destrói o MaterialService e pacotes pesados externos que quebram o jogo
pcall(function()
	local MaterialService = game:GetService("MaterialService")
	if MaterialService then
		for _, v in ipairs(MaterialService:GetChildren()) do
			v:Destroy()
		end
	end
end)

-- 2. Limpeza profunda do workspace para apagar qualquer resquício de textura pesada
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Technology = Enum.Technology.Compatibility
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") then
			v.Enabled = false
		end
	end

	for _, v in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if v:IsA("BasePart") then
				v.Material = Enum.Material.SmoothPlastic
				v.CastShadow = false
				v.Reflectance = 0
			elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
				v:Destroy()
			end
		end)
	end
end)

-- 3. Throttle global para suavizar o fluxo do painel
pcall(function()
	local RunService = game:GetService("RunService")
	local lastExecution = tick()
	
	RunService.Heartbeat:Connect(function()
		if tick() - lastExecution < 0.03 then
			task.wait()
		end
		lastExecution = tick()
	end)
end)

-- 4. Carregamento do Loader oficial do Y-Core
task.spawn(function()
	local success, err = pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/GodErste/Y-Core/refs/heads/main/loader.lua"))()
	end)

	if not success then
		warn("[Y Hub] Erro ao carregar: " + tostring(err))
	else
		print("[Y Hub] Carregado com bloqueio de MaterialService 8K!")
	end
end)
