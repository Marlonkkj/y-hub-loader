-- Função auxiliar para criar caixas de opções/toggles estilo Gakuran
local function createToggle(parent, text, callback)
	local toggleBtn = Instance.new("TextButton")
	toggleBtn.Size = UDim2.new(1, -10, 0, 24)
	toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 25, 30)
	toggleBtn.BorderColor3 = Color3.fromRGB(70, 40, 60)
	toggleBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
	toggleBtn.Text = "  [ ] " .. text
	toggleBtn.TextXAlignment = Enum.TextXAlignment.Left
	toggleBtn.Font = Enum.Font.SourceSans
	toggleBtn.TextSize = 13
	toggleBtn.Parent = parent

	local enabled = false
	toggleBtn.MouseButton1Click:Connect(function()
		enabled = not enabled
		if enabled then
			toggleBtn.Text = "  [X] " .. text
			toggleBtn.BackgroundColor3 = Color3.fromRGB(70, 30, 55) -- Tom magenta ativo
		else
			toggleBtn.Text = "  [ ] " .. text
			toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 25, 30)
		end
		pcall(function()
			callback(enabled)
		end)
	end)
end

