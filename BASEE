--// Y Hub Alt - Throttle Inteligente para Servidores Cheios
pcall(function()
	if setfpscap then
		setfpscap(60)
	end
end)

-- 1. Throttle Avançado de CPU e Rede para impedir sobrecarga em servidores cheios
pcall(function()
	local RunService = game:GetService("RunService")
	local clock = os.clock
	local lastRun = clock()
	
	-- Intercepta o ciclo de renderização para aliviar o processamento simultâneo de múltiplos players
	RunService.Heartbeat:Connect(function()
		local now = clock()
		-- Se houver muitas operações em menos de 15 milissegundos, dá uma pausa estratégica de um frame
		if now - lastRun < 0.015 then
			task.wait()
		end
		lastRun = clock()
	end)
end)

-- 2. Limpeza visual leve para ajudar na performance geral
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") then
			v.Enabled = false
		end
	end
end)

-- 3. Carregamento seguro do Loader original do Y-Core
task.spawn(function()
	local success, err = pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/GodErste/Y-Core/refs/heads/main/loader.lua"))()
	end)

	if not success then
		warn("[Y Hub] Erro ao carregar: " .. tostring(err))
	else
		print("[Y Hub] Carregado com Throttle de Servidores Cheios ativo!")
	end
end)
