--// 0.5 MAP CLEANER + IGNORAR OBJETOS DO MAPA (BYPASS DE COLISÃO SELETIVO)
local function applySmartMapBypass()
	local Workspace = game:GetService("Workspace")
	local Players = game:GetService("Players")

	local function isCharacter(object)
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character and object:IsDescendantOf(player.Character) then
				return true
			end
		end
		return false
	end

	local function optimizeObject(object)
		if isCharacter(object) then return end

		if object:IsA("BasePart") then
			object.Color = Color3.fromRGB(255, 255, 255)
			object.Material = Enum.Material.SmoothPlastic
			object.Reflectance = 0
			object.CastShadow = false

			-- Ignora colisão e raycast de pequenos objetos do mapa para o personagem passar liso
			if object.Size.Magnitude < 15 and not object.Anchored then
				object.CanCollide = false
				object.CanTouch = false
				object.CanQuery = false
			end

		elseif object:IsA("Texture") or object:IsA("Decal") then
			object:Destroy()
		end
	end

	for _, child in ipairs(Workspace:GetDescendants()) do
		optimizeObject(child)
	end

	Workspace.DescendantAdded:Connect(function(child)
		task.wait(0.05)
		optimizeObject(child)
	end)
end
task.spawn(applySmartMapBypass)

