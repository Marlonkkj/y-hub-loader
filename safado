--// 2. FUNÇÃO DE HITBOX (Com Gatilho de Ataque)
globalEnvironment.GetSafeStandPosition = function(targetCharacter, overrideDistance)
	if not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") then
		return nil
	end

	-- Salva o momento exato em que o Hub mandou focar num alvo
	globalEnvironment.LastTargetCommandTime = os.clock()

	local targetRoot = targetCharacter.HumanoidRootPart
	local targetVel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity

	local distance = tonumber(overrideDistance) or -0.5
	local predictedPosition = targetRoot.Position + (targetVel * 0.1)

	local predictedCFrame = CFrame.new(predictedPosition, predictedPosition + targetRoot.CFrame.LookVector)
	local safeCFrame = predictedCFrame * CFrame.new(0, 0, distance)

	return CFrame.lookAt(safeCFrame.Position, targetRoot.Position)
end

--// 3. AUTO CLICKER INTELIGENTE (Só ataca se o Hub mandar)
if not globalEnvironment.__AutoCombatLoop then
	globalEnvironment.__AutoCombatLoop = true

	Services.RunService.RenderStepped:Connect(function()
		-- Verifica se o Hub mandou o boneco ir para o alvo nos últimos 0.2 segundos
		local lastCmdTime = globalEnvironment.LastTargetCommandTime or 0
		if (os.clock() - lastCmdTime) > 0.2 then 
			return -- Cancela os golpes se o ataque estiver desligado ou sem alvo
		end

		local myChar = LocalPlayer.Character
		if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

		Services.VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
		Services.VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)

		if math.random(1, 10) == 1 then
			Services.VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
			Services.VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
		end
	end)
end

