--// 2. ISOLAMENTO DE PROCESSAMENTO DO HITBOX/POSITION COM GATILHO DE COMANDO
local cachedTargetPosition = nil
local lastUpdate = 0

globalEnvironment.GetSafeStandPosition = function(targetCharacter, overrideDistance)
	if not targetCharacter then 
		setAttackState(false)
		return nil 
	end

	-- Ativa o modo de ataque livre e contínuo ao processar a posição do alvo por comando
	setAttackState(true)

	local now = os.clock()
	if now - lastUpdate < 0.05 and cachedTargetPosition then
		return cachedTargetPosition
	end
	lastUpdate = now

	local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	if not targetRoot then 
		setAttackState(false)
		return nil 
	end

	local distance = tonumber(overrideDistance) or 0.8
	local targetCFrame = targetRoot.CFrame

	cachedTargetPosition = targetCFrame * CFrame.new(0, 0, distance)
	return cachedTargetPosition
end

