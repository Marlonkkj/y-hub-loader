--// Alt Account Loader & Otimizador Completo (Y Hub)
pcall(function()
	if setfpscap then
		setfpscap(30) -- Trava o FPS da alt para aliviar totalmente a CPU
	end
end)

-- Otimização gráfica extrema para a alt rodar sem engasgar
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Technology = Enum.Technology.Compatibility
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") then
			v.Enabled = false
		end
	end

	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Material = Enum.Material.SmoothPlastic
			v.CastShadow = false
		elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") then
			v:Destroy()
		end
	end
end)

-- Coletor de lixo agressivo para evitar picos de memória na alt
pcall(function()
	collectgarbage("setpause", 150)
	collectgarbage("setstepmul", 200)
	
	task.spawn(function()
		while task.wait(5) do
			collectgarbage("step", 150)
		end
	end)
end)

-- Carregamento seguro do script/loader oficial na Alt
local success, err = pcall(function()
	loadstring(game:HttpGet("https://raw.githubusercontent.com/GodErste/Y-Core/main/init.lua"))()
end)

if not success then
	warn("[Y Hub Alt] Falha ao carregar: " .. tostring(err))
else
	print("[Y Hub Alt] Injetado com sucesso e otimizado!")
end
