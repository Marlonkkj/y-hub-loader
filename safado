--// 0.2 GLOBAL PARTICLE EXTERMINATOR
local function initParticleTerminator()
	local Workspace = game:GetService("Workspace")
	local function nukeHeavyEffects(obj)
		pcall(function()
			if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") then
				obj:Destroy()
			end
		end)
	end

	pcall(function()
		for _, v in ipairs(Workspace:GetDescendants()) do
			nukeHeavyEffects(v)
		end
		Workspace.DescendantAdded:Connect(nukeHeavyEffects)
	end)
end
task.spawn(initParticleTerminator)

--// 0.3 COMMAND-BASED RAPID FIRE ATTACK BYPASS (LIBERA GOLPES CONSECUTIVOS SÓ QUANDO ORDENADO)
globalEnvironment.__IsAttackingByCommand = false

local function setAttackState(state)
	globalEnvironment.__IsAttackingByCommand = state
end

if not globalEnvironment.__NetworkFilterInstalled then
	globalEnvironment.__NetworkFilterInstalled = true
	
	local rawMetaTable = getrawmetatable(game)
	local originalNamecall = rawMetaTable.__namecall
	setreadonly(rawMetaTable, false)

	local lastRemoteCall = 0

	rawMetaTable.__namecall = newcclosure(function(self, ...)
		local method = getnamecallmethod()
		
		if (method == "FireServer" or method == "InvokeServer") then
			-- Se o comando de ataque estiver ativo, ignora o limite e dispara sem parar!
			if not globalEnvironment.__IsAttackingByCommand then
				local now = os.clock()
				if now - lastRemoteCall < 0.03 then 
					return nil
				end
				lastRemoteCall = now
			end
		end
		
		return originalNamecall(self, ...)
	end)
	
	setreadonly(rawMetaTable, true)
end

