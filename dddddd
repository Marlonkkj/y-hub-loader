--// Y Hub Loader (Versão Ultra Rápida + Aproximação Colada 1.8 Studs)
local globalEnvironment = (getgenv and getgenv()) or _G
local baseEnvironment = (getfenv and getfenv()) or _G
local loaderConfig = globalEnvironment.YHubLoaderConfig
	or globalEnvironment.YCoreLoaderConfig
	or globalEnvironment.YAutoSignalLoaderConfig
	or {}

--// 1. OTIMIZAÇÃO DE VELOCIDADE EXTREMA (Remoção de delays nos loops)
if not globalEnvironment.__AntiLagApplied then
	globalEnvironment.__AntiLagApplied = true

	local rawWait = task.wait
	globalEnvironment.task.wait = function(seconds)
		-- Sem limitação de tempo mínimo para permitir ataques na velocidade máxima do motor
		return rawWait(seconds)
	end

	if type(globalEnvironment.wait) == "function" then
		globalEnvironment.wait = function(seconds)
			return rawWait(seconds)
		end
	end
end

--// 2. LÓGICA DE APROXIMAÇÃO MÁXIMA (1.8 STUDS) E PRECISÃO
globalEnvironment.TargetPlayerName = globalEnvironment.TargetPlayerName or nil

-- Posicionamento colado nas costas a 1.8 studs (Alcance ideal de m3/m1 no Roblox)
globalEnvironment.GetSafeStandPosition = function(targetCharacter, customDistance)
	if not targetCharacter or not targetCharacter:FindFirstChild("HumanoidRootPart") then
		return nil
	end

	local targetRoot = targetCharacter.HumanoidRootPart
	-- Distância reduzida para 1.8 studs para colar totalmente no alvo
	local distance = tonumber(customDistance) or 1.8

	local safeCFrame = targetRoot.CFrame * CFrame.new(0, 0, distance)
	return CFrame.lookAt(safeCFrame.Position, targetRoot.Position)
end

-- Busca o jogador focado
globalEnvironment.GetSpecificTarget = function(forcedName)
	local Players = game:GetService("Players")
	local targetName = forcedName or globalEnvironment.TargetPlayerName
	
	if not targetName or targetName == "" then 
		return nil 
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= Players.LocalPlayer and (player.Name:lower():find(targetName:lower(), 1, true) or player.DisplayName:lower():find(targetName:lower(), 1, true)) then
			if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
				local hum = player.Character:FindFirstChildOfClass("Humanoid")
				if hum and hum.Health > 0 then
					return player.Character
				end
			end
		end
	end
	return nil
end

--// 3. EXECUÇÃO DE ATAQUE RÁPIDO (RenderStepped para taxa de atualização por FPS)
local RunService = game:GetService("RunService")
local LocalPlayer = game:GetService("Players").LocalPlayer

globalEnvironment.StartFastAttack = function()
	if globalEnvironment.__FastAttackConn then return end

	globalEnvironment.__FastAttackConn = RunService.RenderStepped:Connect(function()
		local targetChar = globalEnvironment.GetSpecificTarget()
		if targetChar and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			local fastCF = globalEnvironment.GetSafeStandPosition(targetChar, 1.8)
			if fastCF then
				LocalPlayer.Character.HumanoidRootPart.CFrame = fastCF
			end
		end
	end)
end

globalEnvironment.StopFastAttack = function()
	if globalEnvironment.__FastAttackConn then
		globalEnvironment.__FastAttackConn:Disconnect()
		globalEnvironment.__FastAttackConn = nil
	end
end

-- Ativa o loop instantâneo
globalEnvironment.StartFastAttack()

--// 4. CONFIGURAÇÕES E VARIÁVEIS BASE DO FRAMEWORK
local baseUrl = loaderConfig.BaseUrl or "https://raw.githubusercontent.com/GodErste/Y-Core/main/"
local verbose = loaderConfig.Verbose == true
local automaticCacheBust = tostring(math.floor(os.clock() * 1000000))

local function releaseDiagnosticsEnabled()
	return loaderConfig.ReleaseDiagnostics == true
		or loaderConfig.BridgerReleaseDiagnostics == true
		or loaderConfig.Verbose == true
end

local function getExecutorName()
	local getter = identifyexecutor or getexecutorname
	if type(getter) ~= "function" then return "" end
	local success, name = pcall(getter)
	return success and tostring(name or "") or ""
end

local detectedExecutorName = getExecutorName()

local function isPotassiumExecutor()
	return string.find(string.lower(detectedExecutorName), "potassium", 1, true) ~= nil
end

local function callable(callback)
	if type(callback) == "function" then return callback end
	if type(callback) == "table" then
		return function(...)
			local success, a, b = pcall(callback, ...)
			return success and a or nil
		end
	end
	return function() end
end

local function ensureFunction(environment, name, fallback)
	if type(environment[name]) ~= "function" then
		environment[name] = fallback
	end
	return environment[name]
end

ensureFunction(globalEnvironment, "LPH_ATTRIBUTES", function() end)
ensureFunction(globalEnvironment, "VM", function() end)
ensureFunction(globalEnvironment, "PRESET", function() end)
ensureFunction(globalEnvironment, "NONE", function() end)
ensureFunction(globalEnvironment, "FAST", function() end)

if baseUrl:sub(-1) ~= "/" then baseUrl = baseUrl .. "/" end

local Framework = {
	Name = "Y Hub",
	Version = "0.1.0",
	BaseUrl = baseUrl,
	Cache = {},
	Config = loaderConfig,
	StartedAt = os.clock(),
}

globalEnvironment.YHubFramework = Framework
globalEnvironment.YCoreFramework = Framework

local function normalizeModulePath(modulePath)
	return tostring(modulePath or ""):gsub("\\", "/"):gsub("^/+", "")
end

local function withCacheBust(url)
	if loaderConfig.NoCacheBust == true then return url end
	local separator = string.find(url, "?", 1, true) and "&" or "?"
	return url .. separator .. "v=" .. automaticCacheBust
end

function Framework:Fetch(modulePath)
	return game:HttpGet(withCacheBust(self.BaseUrl .. normalizeModulePath(modulePath)))
end

function Framework:FetchUrl(url)
	return game:HttpGet(withCacheBust(tostring(url)))
end

function Framework:yrequire(modulePath, forceReload)
	modulePath = normalizeModulePath(modulePath)
	if not forceReload and self.Cache[modulePath] ~= nil then
		return self.Cache[modulePath]
	end

	local source = self:Fetch(modulePath)
	local loadedChunk = loadstring(source, "@" .. modulePath)
	local result = loadedChunk()
	if result == nil then result = true end

	self.Cache[modulePath] = result
	return result
end

Framework.Require = Framework.yrequire

function Framework:Start()
	local startSuccess, startResult = pcall(function()
		local gameRegistry = self:yrequire("games/index.lua", self.Config.ForceReload == true)
		local selectedGameId = tostring(self.Config.Game or gameRegistry.Default or "shinsei"):lower()
		local gameInfo = gameRegistry.GetGame and gameRegistry.GetGame(selectedGameId) or gameRegistry.Games[selectedGameId]

		local gameModulePath = gameInfo.Entry or ("games/" .. selectedGameId .. "/init.lua")
		local gameModule = self:yrequire(gameModulePath, self.Config.ForceReload == true)

		if type(gameModule) == "table" and type(gameModule.Start) == "function" then
			return gameModule.Start(self)
		end

		return gameModule
	end)

	return startResult
end

return Framework:Start()
