--// Y Hub - Loader Integrado com Sincronização Automática de Owner do Painel
pcall(function()
	if setfpscap then
		setfpscap(60)
	end
end)

-- 1. Injeção Inteligente: Sincroniza automaticamente com o Owner do Painel
pcall(function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local VirtualInputManager = game:GetService("VirtualInputManager")
	local LocalPlayer = Players.LocalPlayer

	local comboTick = 0
	local nextComboDelay = 40

	-- Função para detetar dinamicamente quem é o owner ativo no painel (evita que mude sozinho)
	local function GetPanelOwner()
		-- Tenta ler variáveis globais comuns usadas por hubs do tipo Y-Core / Alt controllers
		if getgenv().OwnerName and Players:FindFirstChild(getgenv().OwnerName) then
			return Players:FindFirstChild(getgenv().OwnerName)
		end
		-- Se não achar globalmente, assume o jogador local ou a referência principal da tela
		return LocalPlayer
	end

	RunService.Heartbeat:Connect(function(dt)
		local currentOwner = GetPanelOwner()
		if not currentOwner or currentOwner ~= LocalPlayer then 
			return -- Se o painel mudou o foco para outra conta, esta instância descansa para evitar conflito
		end

		local char = LocalPlayer.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then return end

		-- A. Imortalidade Automática no Stand (Apenas para o Owner ativo)
		pcall(function()
			if humanoid.PlatformStand then
				if humanoid.Health < humanoid.MaxHealth then
					humanoid.Health = humanoid.MaxHealth
				end
			end
		end)

		-- B. Combo Dinâmico Seguro (Respeitando o alvo definido pelo painel)
		pcall(function()
			comboTick = comboTick + 1
			if comboTick >= nextComboDelay then
				task.spawn(function()
					local target = nil
					local shortestDist = math.huge
					
					for _, player in ipairs(Players:GetPlayers()) do
						if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
							local targetChar = player.Character
							local targetRoot = targetChar.HumanoidRootPart
							local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
							
							if targetHumanoid and targetHumanoid.Health > 0 then
								local dist = (root.Position - targetRoot.Position).Magnitude
								if dist < shortestDist and dist < 22 then
									shortestDist = dist
									target = targetRoot
								end
							end
						end
					end

					if target then
						root.CFrame = CFrame.new(root.Position, Vector3.new(target.Position.X, target.Position.Y, target.Position.Z))

						local totalHits = math.random(3, 5)
						for i = 1, totalHits do
							VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
							task.wait(0.015)
							VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
							task.wait(0.025)
						end
						
						task.wait(0.04)
						VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
						task.wait(0.03)
						VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
					end
				end)

				comboTick = 0
				nextComboDelay = math.random(35, 70)
			end
		end)
	end)
end)

-- 2. Carregamento Direto do Painel Principal Oficial (Y Hub)
pcall(function()
	getgenv().script_key = "Y-CORE"
	loadstring(game:HttpGet("https://github.com/GodErste/Y-Core/raw/main/loader.lua"))()
end)

print("[Y Hub] Loader Sincronizado: Dono ajustado automaticamente pelo painel!")
