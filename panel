-- 1. Limpeza Estrutural: Mantém apenas as paredes essenciais, removendo texturas, sombras e luzes
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 0
	Lighting.Brightness = 0
	
	for _, v in ipairs(Lighting:GetChildren()) do
		v:Destroy()
	end

	-- Deixa o mapa apenas com as formas das paredes, mas sem nenhuma textura ou detalhes pesados
	for _, v in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if v:IsA("BasePart") then
				v.Material = Enum.Material.Plastic
				v.CastShadow = false
				v.Color = Color3.fromRGB(130, 130, 130)
				v.Reflectance = 0
				-- Desativa colisões em peças desnecessárias para o combate
				if not v.Anchored then
					v.CanCollide = false
				end
			elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sound") or v:IsA("Explosion") then
				v:Destroy()
			end
		end)
	end

	workspace.DescendantAdded:Connect(function(v)
		pcall(function()
			if v:IsA("BasePart") then
				v.Material = Enum.Material.Plastic
				v.CastShadow = false
				v.Color = Color3.fromRGB(130, 130, 130)
				v.Reflectance = 0
			elseif v:IsA("Decal") or v:IsA("Texture") then
				v:Destroy()
			end
		end)
	end)
end)

-- 2. Anti-Lag Severo para Servidores Cheios (Deleta temporariamente quem está longe para zerar o travamento do !attack)
pcall(function()
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local RunService = game:GetService("RunService")

	local counter = 0
	RunService.Heartbeat:Connect(function()
		counter = counter + 1
		if counter % 10 ~= 0 then return end

		pcall(function()
			local localRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if not localRoot then return end

			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local char = player.Character
					local root = char:FindFirstChild("HumanoidRootPart")
					
					if root then
						local distance = (root.Position - localRoot.Position).Magnitude
						-- Se o player estiver a mais de 20 studs, desativa totalmente a modelagem e o rig para poupar o processador
						if distance > 20 then
							for _, part in ipairs(char:GetDescendants()) do
								if part:IsA("BasePart") then
									part.Transparency = 1
									part.CanCollide = false
									part.AssemblyLinearVelocity = Vector3.new(0,0,0)
								elseif part:IsA("Accessory") or part:IsA("Clothing") then
									part.Parent = nil
								end
							end
						else
							-- Quando chega perto para o combate/attack, o personagem reaparece instantaneamente
							for _, part in ipairs(char:GetDescendants()) do
								if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" and part.Transparency == 1 then
									part.Transparency = 0
									part.CanCollide = true
								end
							end
						end
					end
				end
			end
		end)
	end)
end)

-- 3. Combate Otimizado: Movimentação Randômica + Alinhamento Instantâneo de Ataque
pcall(function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local LocalPlayer = Players.LocalPlayer

	local randomMoveTick = 0

	RunService.RenderStepped:Connect(function(dt)
		pcall(function()
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if not root or not humanoid then return end

			randomMoveTick = randomMoveTick + dt
			if randomMoveTick > 1.2 then
				randomMoveTick = 0
				if math.random(1, 2) == 1 then
					humanoid:Move(Vector3.new(math.random(-1, 1), 0, math.random(-1, 1)).Unit, false)
				end
			end

			local target = nil
			local shortestDistance = 15

			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
					local enemyHumanoid = player.Character:FindFirstChildOfClass("Humanoid")
					
					if enemyRoot and enemyHumanoid and enemyHumanoid.Health > 0 then
						local dist = (root.Position - enemyRoot.Position).Magnitude
						if dist < shortestDistance then
							shortestDistance = dist
							target = enemyRoot
						end
					end
				end
			end

			if target then
				root.CFrame = CFrame.new(root.Position, Vector3.new(target.Position.X, root.Position.Y, target.Position.Z))
			end
		end)
	end)
end)

