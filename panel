--// Y Hub - Loader Otimizado (Anti-Trava + Imortalidade no Stand + Combo Seguro Anti-Owner)
pcall(function()
	if setfpscap then
		setfpscap(60)
	end
end)

-- 1. Injeção Silenciosa e Segura (Sem cliques indesejados em aliados/owners)
pcall(function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local VirtualInputManager = game:GetService("VirtualInputManager")
	local LocalPlayer = Players.LocalPlayer

	local comboTick = 0
	local nextComboDelay = 40

	RunService.Heartbeat:Connect(function(dt)
		local char = LocalPlayer.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then return end

		-- A. Imortalidade Automática no Stand
		pcall(function()
			if humanoid.PlatformStand then
				if humanoid.Health < humanoid.MaxHealth then
					humanoid.Health = humanoid.MaxHealth
				end
			end
		end)

		-- B. Combo Dinâmico Seguro (Só ataca se houver um inimigo real por perto)
		pcall(function()
			comboTick = comboTick + 1
			if comboTick >= nextComboDelay then
				task.spawn(function()
					-- Procura um alvo inimigo válido (Evita atacar aliados ou a conta owner)
					local target = nil
					local shortestDist = math.huge
					
					for _, player in ipairs(Players:GetPlayers()) do
						-- Garante que não é o próprio jogador e que o player tem personagem válido
						if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
							local targetChar = player.Character
							local targetRoot = targetChar.HumanoidRootPart
							local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
							
							-- Só mira se o inimigo estiver vivo e dentro de um raio de 22 studs
							if targetHumanoid and targetHumanoid.Health > 0 then
								local dist = (root.Position - targetRoot.Position).Magnitude
								if dist < shortestDist and dist < 22 then
									shortestDist = dist
									target = targetRoot
								end
							end
						end
					end

					-- Se encontrou um inimigo válido na mira, executa o combo perfeitamente
					if target then
						-- Alinha suavemente para acertar o golpe com facilidade
						root.CFrame = CFrame.new(root.Position, Vector3.new(target.Position.X, root.Position.Y, target.Position.Z))

						-- Executa a sequência de 3 a 5 hits + R especial com segurança
						local totalHits = math.random(3, 5)
						for i = 1, totalHits do
							VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
							task.wait(0.015)
							VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
							task.wait(0.025)
						end
						
						-- Solta o R especial certeiro no alvo
						task.wait(0.04)
						VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
						task.wait(0.03)
						VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
					end
				end)

				comboTick = 0
				nextComboDelay = math.random(35, 70)
			end
		end)
	end)
end)

-- 2. Carregamento Direto do Painel Principal Oficial (Y Hub)
pcall(function()
	getgenv().script_key = "Y-CORE"
	loadstring(game:HttpGet("https://github.com/GodErste/Y-Core/raw/main/loader.lua"))()
end)

print("[Y Hub] Versão Segura Carregada: Cliques automáticos restritos apenas a inimigos!")
