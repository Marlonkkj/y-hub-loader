--// Y Hub Alt - Render Distance Limiter (Anti-Lag Extremo para Servidores Cheios)
pcall(function()
	if setfpscap then
		setfpscap(30)
	end
end)

-- 1. Limpeza Gráfica do Mapa (Deixa o cenário com textura lisa e sem sombras pesadas)
pcall(function()
	local Lighting = game:GetService("Lighting")
	Lighting.GlobalShadows = false
	Lighting.FogEnd = 9e9
	Lighting.Technology = Enum.Technology.Compatibility
	
	for _, v in ipairs(Lighting:GetChildren()) do
		if v:IsA("PostEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") then
			v.Enabled = false
		end
	end

	for _, v in ipairs(workspace:GetDescendants()) do
		pcall(function()
			if v:IsA("BasePart") then
				v.Material = Enum.Material.SmoothPlastic
				v.CastShadow = false
				v.Reflectance = 0
			elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") or v:IsA("Explosion") then
				v:Destroy()
			elseif v:IsA("Sound") then
				v:Destroy()
			end
		end)
	end
end)

-- 2. Limite de Renderização Estrito (Render Distance Culling para Jogadores e Funções do Painel)
pcall(function()
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	local RunService = game:GetService("RunService")

	local MAX_DISTANCE = 35 -- Limite máximo em studs: tudo além disso é ocultado e desativado da engine
	local counter = 0

	RunService.Heartbeat:Connect(function()
		counter = counter + 1
		if counter % 10 ~= 0 then return end -- Executa a cada 10 frames para poupar o processador

		pcall(function()
			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root then return end

			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local enemyChar = player.Character
					local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")

					if enemyRoot then
						local dist = (root.Position - enemyRoot.Position).Magnitude
						
						if dist > MAX_DISTANCE then
							-- Fora do raio: Esconde totalmente e desliga colisões e efeitos para liberar o painel
							for _, part in ipairs(enemyChar:GetDescendants()) do
								if part:IsA("BasePart") then
									part.Transparency = 1
									part.CanCollide = false
								elseif part:IsA("Decal") or part:IsA("Texture") or part:IsA("BillboardGui") then
									part.Transparency = 1
								end
							end
						else
							-- Dentro do raio: Restaura a visibilidade apenas para quem está perto de você
							for _, part in ipairs(enemyChar:GetDescendants()) do
								if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
									part.Transparency = 0
									part.CanCollide = true
								elseif part:IsA("Decal") or part:IsA("Texture") or part:IsA("BillboardGui") then
									part.Transparency = 0
								end
							end
						end
					end
				end
			end
		end)
	end)
end)

-- 3. Coletor de Lixo Automático para Estabilizar a Memória RAM
pcall(function()
	collectgarbage("setpause", 100)
	collectgarbage("setstepmul", 300)
	
	task.spawn(function()
		while task.wait(2) do
			collectgarbage("step", 300)
		end
	end)
end)

-- 4. Carregamento Isolado do Loader Oficial do Painel
task.spawn(function()
	local success, err = pcall(function()
		loadstring(game:HttpGet("https://raw.githubusercontent.com/GodErste/Y-Core/refs/heads/main/loader.lua"))()
	end)

	if not success then
		warn("[Y Hub Alt] Falha no loader: " .. tostring(err))
	else
		print("[Y Hub Alt] Rodando com Limite de Renderização Estrito!")
	end
end)
