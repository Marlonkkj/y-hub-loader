--// Y Hub - Lógica Global Otimizada para Integração em GUI Externa
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Variáveis de Estado das Funções
local _G_NoClip = false
local _G_GodMode = false
local _G_ChaosFly = false
local _G_AutoCombo = false

local flySpeed = 1.6
local currentPos = nil
local chaosTick = 0
local comboStep = 0

-- Funções de Controle (Ligue/Desligue nos botões da GUI deles)
local YHubFunctions = {}

function YHubFunctions.ToggleNoClip(state)
	_G_NoClip = state
end

function YHubFunctions.ToggleGodMode(state)
	_G_GodMode = state
end

function YHubFunctions.ToggleChaosFly(state)
	_G_ChaosFly = state
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")

	if _G_ChaosFly then
		if root then currentPos = root.CFrame; root.Anchored = true end
		if humanoid then humanoid.PlatformStand = true end
	else
		if root then root.Anchored = false end
		if humanoid then humanoid.PlatformStand = false end
	end
end

function YHubFunctions.ToggleAutoCombo(state)
	_G_AutoCombo = state
end

function YHubFunctions.SetSpeed(val)
	flySpeed = math.clamp(val, 0.2, 10.0)
end

-- Loop Principal de Processamento (Leve, sem travar o servidor cheio)
RunService.RenderStepped:Connect(function()
	local char = LocalPlayer.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")

	-- 1. NoClip Global
	if _G_NoClip and root then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end

	-- 2. Anti-Morte / Imortalidade Suave
	if _G_GodMode and humanoid then
		if humanoid.Health < humanoid.MaxHealth then
			humanoid.Health = humanoid.MaxHealth
		end
		if humanoid.PlatformStand and not _G_ChaosFly then
			humanoid.PlatformStand = false
		end
	end

	-- 3. Voo Caótico (Impossível de acertar golpes)
	if _G_ChaosFly and root then
		local camCFrame = Camera.CFrame
		local moveDirection = Vector3.new(0, 0, 0)

		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDirection = moveDirection + camCFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDirection = moveDirection - camCFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDirection = moveDirection - camCFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDirection = moveDirection + camCFrame.RightVector end

		if currentPos then
			if moveDirection.Magnitude > 0 then
				currentPos = currentPos + (moveDirection.Unit * flySpeed)
			end
			
			chaosTick = chaosTick + 1
			-- Trepidação e telemetria invisível para confundir a mira dos outros
			local jitterX = math.sin(chaosTick * 1.8) * 1.5
			local jitterY = math.cos(chaosTick * 2.2) * 0.9
			local jitterZ = math.cos(chaosTick * 1.5) * 1.5
			
			root.CFrame = CFrame.new(currentPos.Position + Vector3.new(jitterX, jitterY, jitterZ)) * camCFrame.Rotation * CFrame.Angles(math.rad(-90), 0, 0)
		end
	end

	-- 4. Combo Automático (3 Hits + Tecla R)
	if _G_AutoCombo then
		comboStep = comboStep + 1
		if comboStep == 30 then
			pcall(function()
				for i = 1, 3 do
					VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
					task.wait(0.02)
					VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
					task.wait(0.05)
				end
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
				task.wait(0.05)
				VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
			end)
			comboStep = 0
		end
	end
end)

return YHubFunctions
