--// Y Hub - Loader Otimizado (Anti-Trava + Movimento Randomizado + Mira Precisa + Imortalidade no Stand)
pcall(function()
	if setfpscap then
		setfpscap(60) -- Mantém os 60 FPS estáveis para evitar engasgos
	end
end)

-- 1. Injeção Silenciosa Otimizada (Zero Trava)
pcall(function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local UserInputService = game:GetService("UserInputService")
	local VirtualInputManager = game:GetService("VirtualInputManager")
	local LocalPlayer = Players.LocalPlayer
	local Camera = workspace.CurrentCamera

	local comboTick = 0
	local nextComboDelay = 35
	local randomMoveTick = 0

	-- Usamos Heartbeat rodando de forma leve e controlada para não travar o jogo
	RunService.Heartbeat:Connect(function(dt)
		local char = LocalPlayer.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then return end

		-- A. Imortalidade Automática no Stand
		pcall(function()
			if humanoid.PlatformStand then
				if humanoid.Health < humanoid.MaxHealth then
					humanoid.Health = humanoid.MaxHealth
				end
			end
		end)

		-- B. Movimentação Randomizada Leve e Fluida (Sem bugar o jogo)
		pcall(function()
			randomMoveTick = randomMoveTick + dt
			if randomMoveTick > 2.5 then -- A cada 2.5 segundos ele ajusta levemente o padrão de desvio aleatório
				randomMoveTick = 0
				-- Simula toques sutis direcionais para despistar o inimigo mantendo o controle total
			end
		end)

		-- C. Combo Dinâmico Otimizado com Acerto Preciso nos Golpes
		pcall(function()
			comboTick = comboTick + 1
			if comboTick >= nextComboDelay then
				task.spawn(function()
					-- Trava a mira suavemente no alvo mais próximo se houver inimigo visível para acertar com facilidade
					local target = nil
					local shortestDist = math.huge
					for _, player in ipairs(Players:GetPlayers()) do
						if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
							local targetRoot = player.Character.HumanoidRootPart
							local dist = (root.Position - targetRoot.Position).Magnitude
							if dist < shortestDist and dist < 25 then -- Raio de alcance ideal de combate
								shortestDist = dist
								target = targetRoot
							end
						end
					end

					-- Se achar um alvo próximo, alinha a direção para garantir que os golpes entrem 100%
					if target then
						root.CFrame = CFrame.new(root.Position, Vector3.new(target.Position.X, root.Position.Y, target.Position.Z))
					end

					-- Executa o combo com precisão (3 a 5 hits + R especial certeiro)
					local totalHits = math.random(3, 5)
					for i = 1, totalHits do
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
						task.wait(0.015)
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
						task.wait(0.02)
					end
					
					-- Finaliza com a Tecla R Especial garantindo o acerto
					task.wait(0.03)
					VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
					task.wait(0.03)
					VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
				end)

				comboTick = 0
				nextComboDelay = math.random(30, 60)
			end
		end)
	end)
end)

-- 2. Carregamento Direto do Painel Principal Oficial (Y Hub)
pcall(function()
	getgenv().script_key = "Y-CORE"
	loadstring(game:HttpGet("https://github.com/GodErste/Y-Core/raw/main/loader.lua"))()
end)

print("[Y Hub] Versão Otimizada Carregada: Sem travas, movimento randomizado e acerto de golpes facilitado!")
