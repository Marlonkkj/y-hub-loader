--// Y Hub - Loader Corrigido (Anti-Fogo Amigo + Imortalidade no Stand + Combo Seguro)
pcall(function()
	if setfpscap then
		setfpscap(60)
	end
end)

-- 1. Injeção Silenciosa com Filtro Anti-Fogo Amigo (Não bate no Owner nem em quem usa o Stand)
pcall(function()
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local VirtualInputManager = game:GetService("VirtualInputManager")
	local LocalPlayer = Players.LocalPlayer

	local comboTick = 0
	local nextComboDelay = 45

	RunService.Heartbeat:Connect(function(dt)
		local char = LocalPlayer.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart")
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid then return end

		-- A. Imortalidade Automática no Stand
		pcall(function()
			if humanoid.PlatformStand then
				if humanoid.Health < humanoid.MaxHealth then
					humanoid.Health = humanoid.MaxHealth
				end
			end
		end)

		-- B. Combo Dinâmico Blindado (Nunca ataca o owner, contas parceiras ou quem está no stand)
		pcall(function()
			comboTick = comboTick + 1
			if comboTick >= nextComboDelay then
				task.spawn(function()
					local target = nil
					local shortestDist = math.huge
					
					for _, player in ipairs(Players:GetPlayers()) do
						-- Bloqueia totalmente o ataque a si mesmo, ao dono do painel ou contas aliadas
						if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
							local targetChar = player.Character
							local targetRoot = targetChar.HumanoidRootPart
							local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
							
							-- Verifica se o player alvo NÃO está em PlatformStand (ou seja, ignora quem está usando o stand/owner)
							if targetHumanoid and targetHumanoid.Health > 0 and not targetHumanoid.PlatformStand then
								local dist = (root.Position - targetRoot.Position).Magnitude
								if dist < shortestDist and dist < 22 then
									shortestDist = dist
									target = targetRoot
								end
							end
						end
					end

					-- Só ataca se encontrar um inimigo real fora do estado de stand
					if target then
						root.CFrame = CFrame.new(root.Position, Vector3.new(target.Position.X, target.Position.Y, target.Position.Z))

						local totalHits = math.random(3, 5)
						for i = 1, totalHits do
							VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
							task.wait(0.015)
							VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
							task.wait(0.025)
						end
						
						task.wait(0.04)
						VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.R, false, game)
						task.wait(0.03)
						VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.R, false, game)
					end
				end)

				comboTick = 0
				nextComboDelay = math.random(40, 75)
			end
		end)
	end)
end)

-- 2. Carregamento Direto do Painel Principal Oficial (Y Hub)
pcall(function()
	getgenv().script_key = "Y-CORE"
	loadstring(game:HttpGet("https://github.com/GodErste/Y-Core/raw/main/loader.lua"))()
end)

print("[Y Hub] Versão Final Ajustada: Fogo amigo bloqueado com sucesso!")
